# Copie para .env e preencha. O .env fica fora do Git.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_ACCESS_KEY_ID=
NVIDIA_API_KEY=
# GEMINI_API_KEY_RESERVA=           (outra chave do AI Studio; entra quando a principal fica sem cota)
# GEMINI_AGENT_PLATFORM_KEY=        (chave do Agent Platform do Google; não vale no AI Studio)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Opcional
# GITHUB_TOKEN=                    (só para aprender muitos repositórios por hora)
# NEXO_NOME=Jarvis                 (nome do assistente e palavra que o acorda)
# NEXO_TRATAMENTO=senhor            (como ele chama você)
# NEXO_MYHUB_LIMITE_DIA=40          (consultas por dia ao MyHub.IA)
# NEXO_CIDADE=Brasília              (clima do bom dia)
# NEXO_BOM_DIA=07:45               (hora do bom dia)
# NEXO_FISH_SITE=1                  (voz pelo site do fish.audio, depois de: python -m nexo fish login)
# NEXO_FISH_LIMITE_DIA=150          (gerações por dia pelo site)
# FISH_API_KEY=                     (API do fish.audio: voz principal do Jarvis; o site fica de reserva)
# NEXO_FISH_MODELO=s2.1-pro-free     (cabeçalho "model" da API)
# NEXO_FISH_VOZ=fee533e18ed246f7bcbe4f2764fe900b   (modelId da opção "Jarvis" do seletor de voz)
# NEXO_VOZ=pt-BR-AntonioNeural     (voz do Edge TTS, reserva do Fish Audio)
# NEXO_GEMINI_MODELO=gemini-3.5-flash
# NEXO_GEMINI_MODELO_PROFUNDO=gemini-3.1-pro-preview
# NEXO_NVIDIA_MODELO_RAPIDO=minimaxai/minimax-m3.1-flash
# NEXO_NVIDIA_MODELO_PROFUNDO=nvidia/nemotron-3-ultra-550b-a55b
# NEXO_CLAUDE_MODELO=claude-opus-5-5
# NEXO_OLLAMA_PRIMEIRO=1            (tenta o Ollama local antes da nuvem; mais lento, mas os pedidos ficam no PC)
# NEXO_CEREBRO=C:\caminho\para\outro\vault
# NEXO_TECLA=ctrl+alt+j            (atalho global do painel; nenhum = desligado)
# NEXO_TIME_ESPN=7632               (time do card GALO; 7632 = Atlético-MG)

# Agenda e e-mail (só leitura; o bom dia passa a citar compromissos e e-mails não lidos)
# NEXO_AGENDA_ICS=                  (Google Agenda > Configurações > sua agenda > "Endereço secreto em formato iCal"; várias separadas por vírgula)
# NEXO_EMAIL_USUARIO=voce@gmail.com
# NEXO_EMAIL_SENHA_APP=             (senha de app do Google: Conta > Segurança > Senhas de app; não é a senha normal)
# NEXO_EMAIL_IMAP=imap.gmail.com

# Telegram (falar com o Jarvis pelo celular; os avisos da vigia também chegam lá)
# NEXO_TELEGRAM_TOKEN=              (crie o bot com o @BotFather)
# NEXO_TELEGRAM_CHAT=               (mande uma mensagem ao bot: ele responde com este número; só este chat é atendido)

# Whisper local, câmera e busca por significado
# NEXO_WHISPER_MODELO=small         (transcrição no PC: modo privado, sem internet ou sem cota do Gemini)
# NEXO_OLLAMA_VISAO=llava           (câmera no modo privado; instale com: ollama pull llava)
# NEXO_CAMERA=0                     (qual webcam usar)
# NEXO_EMBEDDING_MODELO=gemini-embedding-001
