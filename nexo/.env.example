# Copie para .env e preencha. O .env fica fora do Git.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_ACCESS_KEY_ID=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Opcional
# GITHUB_TOKEN=                    (só para aprender muitos repositórios por hora)
# NEXO_NOME=Jarvis                 (nome do assistente e palavra que o acorda)
# NEXO_TRATAMENTO=senhor            (como ele chama você)
# NEXO_MYHUB_LIMITE_DIA=40          (consultas por dia ao MyHub.IA)
# NEXO_CIDADE=Brasília              (clima do bom dia)
# NEXO_BOM_DIA=07:45               (hora do bom dia)
# NEXO_FISH_SITE=1                  (voz pelo site do fish.audio, depois de: python -m nexo fish login)
# NEXO_FISH_LIMITE_DIA=150          (gerações por dia pelo site)
# FISH_API_KEY=                     (API do fish.audio: voz principal do Jarvis; o site fica de reserva)
# NEXO_FISH_MODELO=s2.1-pro-free     (cabeçalho "model" da API)
# NEXO_FISH_VOZ=fee533e18ed246f7bcbe4f2764fe900b   (modelId da opção "Jarvis" do seletor de voz)
# NEXO_VOZ=pt-BR-AntonioNeural     (voz do Edge TTS, reserva do Fish Audio)
# NEXO_GEMINI_MODELO=gemini-3.5-flash
# NEXO_CLAUDE_MODELO=claude-opus-5-5
# NEXO_CEREBRO=C:\caminho\para\outro\vault
# NEXO_TECLA=ctrl+alt+j            (atalho global do painel; nenhum = desligado)
# NEXO_TIME_ESPN=7632               (time do card GALO; 7632 = Atlético-MG)
